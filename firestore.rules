rules_version = '2';

// Everything a family owns lives under its own document, so one membership
// check covers the recipes and every week at once.
service cloud.firestore {
  match /databases/{database}/documents {

    // Which family a user belongs to. Yours and yours only.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /families/{familyId} {
      function isMember() {
        return request.auth != null && request.auth.uid in resource.data.members;
      }

      allow get: if isMember();
      // No listing: the family id is the join code, so enumerating families
      // would hand out every code there is.
      allow list: if false;
      allow delete: if false;

      // You can only create a family you are the sole member of.
      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.uid];

      // A member can edit the family. Anyone else can do exactly one thing:
      // append their own uid to `members`. That is what redeeming a family
      // code is — no invite documents, no server.
      allow update: if isMember()
        || (
          request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        );

      // Recipes and weeks. `get()` reads the parent family rather than trusting
      // a familyId field on the document itself.
      match /{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/families/$(familyId)).data.members;
      }
    }
  }
}
