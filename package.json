{
  "name": "family-meal-planner",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run check && npm run build && firebase deploy",
    "contrast": "node scripts/contrast.mjs",
    "check": "tsc --noEmit && vitest run && node scripts/contrast.mjs",
    "deploy:hosting": "npm run check && npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "firebase": "^12.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
